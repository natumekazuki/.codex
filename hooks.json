{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -Command '$codexHome = if ([string]::IsNullOrWhiteSpace($env:CODEX_HOME)) { Join-Path $HOME \".codex\" } else { $env:CODEX_HOME }; & (Join-Path $codexHome \"hooks/implementation-restraint.ps1\")'",
            "commandWindows": "pwsh -NoProfile -ExecutionPolicy Bypass -Command \"$codexHome = if ([string]::IsNullOrWhiteSpace($env:CODEX_HOME)) { Join-Path $env:USERPROFILE '.codex' } else { $env:CODEX_HOME }; & (Join-Path $codexHome 'hooks/implementation-restraint.ps1')\"",
            "timeout": 5,
            "statusMessage": "Applying implementation restraint"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(default|worker|explorer|general_sol|general_luna)$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -Command '$codexHome = if ([string]::IsNullOrWhiteSpace($env:CODEX_HOME)) { Join-Path $HOME \".codex\" } else { $env:CODEX_HOME }; & (Join-Path $codexHome \"hooks/implementation-restraint.ps1\")'",
            "commandWindows": "pwsh -NoProfile -ExecutionPolicy Bypass -Command \"$codexHome = if ([string]::IsNullOrWhiteSpace($env:CODEX_HOME)) { Join-Path $env:USERPROFILE '.codex' } else { $env:CODEX_HOME }; & (Join-Path $codexHome 'hooks/implementation-restraint.ps1')\"",
            "timeout": 5,
            "statusMessage": "Applying implementation restraint"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -Command '$codexHome = if ([string]::IsNullOrWhiteSpace($env:CODEX_HOME)) { Join-Path $HOME \".codex\" } else { $env:CODEX_HOME }; & (Join-Path $codexHome \"hooks/implementation-restraint.ps1\")'",
            "commandWindows": "pwsh -NoProfile -ExecutionPolicy Bypass -Command \"$codexHome = if ([string]::IsNullOrWhiteSpace($env:CODEX_HOME)) { Join-Path $env:USERPROFILE '.codex' } else { $env:CODEX_HOME }; & (Join-Path $codexHome 'hooks/implementation-restraint.ps1')\"",
            "timeout": 5,
            "statusMessage": "Restoring implementation restraint"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(spawn_agent|Agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -Command '$codexHome = if ([string]::IsNullOrWhiteSpace($env:CODEX_HOME)) { Join-Path $HOME \".codex\" } else { $env:CODEX_HOME }; & (Join-Path $codexHome \"hooks/subagent-fork-default.ps1\")'",
            "commandWindows": "pwsh -NoProfile -ExecutionPolicy Bypass -Command \"$codexHome = if ([string]::IsNullOrWhiteSpace($env:CODEX_HOME)) { Join-Path $env:USERPROFILE '.codex' } else { $env:CODEX_HOME }; & (Join-Path $codexHome 'hooks/subagent-fork-default.ps1')\"",
            "timeout": 5,
            "statusMessage": "Setting subagent history default"
          }
        ]
      }
    ]
  }
}
