# この設定ホームは配布対象を明示する。未登録のルートパスは無視する。
/*

# 配布元の入口と、実設定ではない公開例
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/config.example.toml
!/hooks.json

# 配布専用の文書・テンプレート・開発メタデータ
!/docs/
!/templates/
!/.github/
!/.githooks/

# 利用者の設定と混在し得る領域は、配布するファイル名だけ許可する
!/.codex/
/.codex/*
!/.codex/model-instructions-withmate.ja.md
!/.codex/model-instructions-withmate.md
!/agents/
/agents/*
!/agents/general_astra.toml
!/agents/general_luna.toml
!/agents/general_sol.toml
!/agents/general_terra.toml
!/config/
/config/*
!/config/agents.example.toml
!/config/astra.config.toml
!/config/sol.config.toml
!/hooks/
/hooks/*
!/hooks/implementation-restraint.ps1
!/hooks/subagent-fork-default.ps1
!/hooks/test-windows-launch.ps1
!/scripts/
/scripts/*
!/scripts/capture-codex-system-prompt.ps1
!/scripts/check-repo.py
!/scripts/sync-natural-japanese.ps1

# Skillは配布パッケージ単位で許可する。未登録のSkillやpluginは公開しない
!/skills/
/skills/*
!/skills/audit-codex-work-quality/
!/skills/design-ui-information/
!/skills/japanese-tech-writing-review/
!/skills/natural-japanese/
!/skills/relaygraph/
!/skills/session-graph/

# 許可領域内でも実設定・認証・ローカル上書き・生成物は無視する
.DS_Store
.env
.env.*
.credentials.json
auth.json
auth.json.lock
auth.lock
secrets/
*.pem
*.key
*.local.*
*.bak
*.bak.*
*.backup
*.before-*
*.tmp
*.tmp-*
*~
*.log
__pycache__/
*.py[cod]
node_modules/
bin/
obj/
*.sqlite
*.sqlite-shm
*.sqlite-wal
config.toml
history.jsonl
session_index.jsonl
session_index.jsonl.lock
models_cache*.json
internal_storage.json
/.codex-provisioning-*.guard
/.sqlite-maintenance.lock
/hooks/.astra-routing-state/
